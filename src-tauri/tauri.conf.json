{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Taskboard",
  "version": "0.2.0",
  "identifier": "com.chuspeeism.codex-taskboard",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex Taskboard",
        "width": 460,
        "height": 390,
        "minWidth": 420,
        "minHeight": 350,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "在 Codex 客户端中打开本地任务面板",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/": ""
    },
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzOTE3QTI2OTdFNUNDOUQKUldTZHpPV1hKbnFSSStlc3dBblBhVzEydlRGR29seE5EeDhyUFR4NUZDT29kSHQ3MTFES2xuK0IK",
      "endpoints": [
        "https://github.com/chuspeeism/dashi-taskboard/releases/latest/download/latest.json"
      ]
    }
  }
}
